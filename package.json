{
	"name": "omp-startup",
	"version": "0.1.11",
	"description": "Custom startup dashboard for omp and Pi coding agents.",
	"author": "Zhu Lin <zhulin@czl.my>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zhulinchng/omp-startup.git"
	},
	"homepage": "https://github.com/zhulinchng/omp-startup#readme",
	"bugs": {
		"url": "https://github.com/zhulinchng/omp-startup/issues"
	},
	"keywords": [
		"omp",
		"pi",
		"oh-my-pi",
		"coding-agent",
		"dashboard",
		"welcome",
		"startup",
		"tui",
		"extension",
		"plugin",
		"pi-package"
	],
	"files": [
		"src",
		"types.d.ts",
		"docs",
		"scripts/uninstall-reset.js",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"main": "./src/index.ts",
	"type": "module",
	"license": "MIT",
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
		"test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
		"prepublishOnly": "npm run typecheck && npm test && npm run smoke",
		"postuninstall": "node scripts/uninstall-reset.js || true"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.6.0"
	}
}
